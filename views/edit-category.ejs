<%- include('partials/header') %>

<h1><%= title %></h1>

<% if (locals.errors && errors.length > 0) { %>
    <div class="alert alert-error">
        <ul>
            <% errors.forEach(err => { %> <li><%= err %></li> <% }); %>
        </ul>
    </div>
<% } %>

<form action="/categories/edit-category/<%= category.category_id %>" method="POST" class="form">
    <div class="form-group">
        <label for="name">Category Name:</label>
        <input type="text" id="name" name="name" value="<%= category.name %>" required maxlength="100">
    </div>
    <button type="submit" class="button">Update Category</button>
    <a href="/categories" class="button button-secondary">Cancel</a>
</form>

<%- include('partials/footer') %>
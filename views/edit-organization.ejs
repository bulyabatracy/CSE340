<%- include('partials/header') %>
    <h1>
        <%= title %>
    </h1>

    <% if (locals.errors && errors.length> 0) { %>
        <div class="alert alert-error">
            <ul>
                <% errors.forEach(err=> { %> <li>
                        <%= err %>
                    </li>
                    <% }); %>
            </ul>
        </div>
        <% } %>

            <form action="/organizations/edit-organization/<%= org.organization_id %>" method="POST" class="form">
                <div class="form-group">
                    <label for="name">Organization Name:</label>
                    <input type="text" id="name" name="name" value="<%= org.name %>" required minlength="3"
                        maxlength="100" pattern=".*\S.*">
                </div>
                <div class="form-group">
                    <label for="description">Description:</label>
                    <input type="text" id="description" name="description" value="<%= org.description %>" required
                        maxlength="5000" pattern=".*\S.*">
                </div>
                <div class="form-group">
                    <label for="contact_email">Contact Email:</label>
                    <input type="email" id="contact_email" name="contact_email" value="<%= org.contact_email %>"
                        required maxlength="254">
                </div>
                <div class="form-group">
                    <label for="logo_filename">Logo Filename:</label>
                    <input type="text" id="logo_filename" name="logo_filename" value="<%= org.logo_filename %>" required
                        maxlength="255" pattern=".*\S.*">
                </div>
                <button type="submit" class="button">Update Organization</button>
                <a href="/organizations" class="button button-secondary">Cancel</a>
            </form>

            <%- include('partials/footer') %>
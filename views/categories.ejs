<%- include('partials/header') %>

    <h1>
        <%= title %>
    </h1>
    <p>Browse service projects by category.</p>

    <ul class="category-list" role="list">
        <% categories.forEach((category)=> { %>
            <li class="category-item">
                <!-- Wrap the name in a link to the category details page -->
                <a href="/categories/<%= category.category_id %>" class="text-link">
                    <%= category.name %>
                </a>
            </li>
            <% }); %>
    </ul>

    <%- include('partials/footer') %>
<%- include('partials/header') %>

    <h1>
        <%= project.name %>
    </h1>
    <% if (messages.success) { %>
        <div class="alert alert-success">
            <%= messages.success %>
        </div>
        <% } %>
            <% if (messages.error) { %>
                <div class="alert alert-error">
                    <%= messages.error %>
                </div>
                <% } %>
                    <p>
                        <%= project.description %>
                    </p>
                    <p><strong>Date:</strong>
                        <%= project.project_date.toLocaleDateString() %>
                    </p>
                    <p><strong>Location:</strong>
                        <%= project.location %>
                    </p>
                    <p><strong>Organization:</strong>
                        <a href="/organizations/<%= project.organization_id %>" class="text-link">
                            <%= project.organization_name %>
                        </a>
                    </p>

                    <!-- NEW: Action Buttons -->
                    <% if (currentUser && currentUser.role==='admin' ) { %>
                        <div style="display: flex; gap: 1rem; margin-bottom: 2rem; margin-top: 1.5rem;">
                            <a href="/projects/<%= project.project_id %>/assign-categories" class="button">
                                Manage Categories
                            </a>
                            <a href="/projects/edit-project/<%= project.project_id %>" class="button">
                                Edit Project
                            </a>
                        </div>
                        <% } %>

                            <h3>Categories:</h3>
                            <div class="category-tags">
                                <% if (categories.length===0) { %>
                                    <p>No categories assigned yet.</p>
                                    <% } else { %>
                                        <% categories.forEach((category)=> { %>
                                            <a href="/categories/<%= category.category_id %>" class="tag">
                                                <%= category.name %>
                                            </a>
                                            <% }); %>
                                                <% } %>
                            </div>

                            <%- include('partials/footer') %>
<%- include('partials/header') %>
    <h1>
        <%= project.name %>
    </h1>
    <p>
        <%= project.description %>
    </p>
    <p><strong>Date:</strong>
        <%= project.project_date.toLocaleDateString() %>
    </p>
    <p><strong>Location:</strong>
        <%= project.location %>
    </p>
    <p><strong>Organization:</strong> <a href="/organizations/<%= project.organization_id %>" class="text-link">
            <%= project.organization_name %>
        </a></p>

    <h3>Categories:</h3>
    <div class="category-tags">
        <% categories.forEach((category)=> { %>
            <a href="/categories/<%= category.category_id %>" class="tag">
                <%= category.name %>
            </a>
            <% }); %>
    </div>
    <%- include('partials/footer') %>
<%- include('partials/header') %>

    <h1>
        <%= title %>
    </h1>
    <p>Current and upcoming service projects.</p>

    <section class="card-grid">
        <% projects.forEach((project)=> { %>
            <article class="card">
                <div class="card-body">
                    <h2>
                        <%= project.name %>
                    </h2>
                    <p>
                        <%= project.description %>
                    </p>
                    <p><strong>Date:</strong>
                        <%= project.project_date.toLocaleDateString() %>
                    </p>
                    <p><strong>Location:</strong>
                        <%= project.location %>
                    </p>
                </div>
            </article>
            <% }); %>
    </section>

    <%- include('partials/footer') %>
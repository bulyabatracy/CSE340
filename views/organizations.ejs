<%- include('partials/header') %>

    <h1>
        <%= title %>
    </h1>
    <p>Partner organizations in the Nonprofit Network.</p>

    <section class="card-grid">
        <article class="card">
            <img src="/images/green-roots.png" alt="Green Roots Alliance logo" class="card-image" width="64"
                height="64" />
            <h2>Green Roots Alliance</h2>
            <p>Community-led reforestation and urban gardening projects.</p>
        </article>
        <article class="card">
            <img src="/images/bright-futures.png" alt="Bright Futures Tutoring logo" class="card-image" width="64"
                height="64" />
            <h2>Bright Futures Tutoring</h2>
            <p>Free after-school tutoring for at-risk youth.</p>
        </article>
        <article class="card">
            <img src="/images/open-pantry.png" alt="Open Pantry Network logo" class="card-image" width="64"
                height="64" />
            <h2>Open Pantry Network</h2>
            <p>Food security and nutrition education for local families.</p>
        </article>
    </section>

    <%- include('partials/footer') %>
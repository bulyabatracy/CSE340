<%- include('partials/header') %>

    <h1>
        <%= title %>
    </h1>
    <p>Partner organizations in the Nonprofit Network.</p>

    <section class="card-grid">
        <% organizations.forEach((org)=> { %>
            <article class="card has-image">
                <!-- Dynamically pull the image name from the database -->
                <img src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo" class="card-image" />
                <div class="card-body">
                    <!-- Dynamically pull the name and description -->
                    <h2>
                        <%= org.name %>
                    </h2>
                    <p>
                        <%= org.description %>
                    </p>
                </div>
            </article>
            <% }); %>
    </section>

    <%- include('partials/footer') %>
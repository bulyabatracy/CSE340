<%- include('partials/header') %>

    <h1>
        <%= title %>
    </h1>

    <% if (locals.errors && errors.length> 0) { %>
        <div class="alert alert-error">
            <ul>
                <% errors.forEach(err=> { %> <li>
                        <%= err %>
                    </li>
                    <% }); %>
            </ul>
        </div>
        <% } %>

            <form action="/categories/new-category" method="POST" class="form">
                <div class="form-group">
                    <label for="name">Category Name:</label>
                    <input type="text" id="name" name="name" value="<%= name %>" required minlength="3" maxlength="100"
                        pattern=".*\S.*">
                </div>
                <button type="submit" class="button">Create Category</button>
                <a href="/categories" class="button button-secondary">Cancel</a>
            </form>

            <%- include('partials/footer') %>
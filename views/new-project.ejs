<%- include('partials/header') %>
    <h1>
        <%= title %>
    </h1>

    <% if (locals.errors && errors.length> 0) { %>
        <div class="alert alert-error">
            <ul>
                <% errors.forEach(err=> { %> <li>
                        <%= err %>
                    </li>
                    <% }); %>
            </ul>
        </div>
        <% } %>

            <form action="/projects/new-project" method="POST" class="form">
                <div class="form-group">
                    <label for="organization_id">Organization:</label>
                    <select id="organization_id" name="organization_id" required>
                        <option value="">-- Select Organization --</option>
                        <% organizations.forEach(org=> { %>
                            <option value="<%= org.organization_id %>" <%=project.organization_id==org.organization_id
                                ? 'selected' : '' %>>
                                <%= org.name %>
                            </option>
                            <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="name">Project Name:</label>
                    <input type="text" id="name" name="name" value="<%= project.name || '' %>" required minlength="3"
                        maxlength="100" pattern=".*\S.*">
                </div>
                <div class="form-group">
                    <label for="description">Description:</label>
                    <input type="text" id="description" name="description" value="<%= project.description || '' %>"
                        required pattern=".*\S.*">
                </div>
                <div class="form-group">
                    <label for="project_date">Date:</label>
                    <input type="date" id="project_date" name="project_date" value="<%= project.project_date || '' %>"
                        required>
                </div>
                <div class="form-group">
                    <label for="location">Location:</label>
                    <input type="text" id="location" name="location" value="<%= project.location || '' %>" required
                        pattern=".*\S.*">
                </div>
                <button type="submit" class="button">Create Project</button>
                <a href="/projects" class="button button-secondary">Cancel</a>
            </form>

            <%- include('partials/footer') %>
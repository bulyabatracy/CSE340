<%- include('partials/header', { title }) %>
    <main class="page-content">
        <p class="eyebrow">Find your next opportunity</p>
        <h1>
            <%= title %>
        </h1>
        <p class="intro">Small acts of service add up. Explore a few ways to get involved.</p>
        <section class="organization-list" aria-label="Service projects">
            <article>
                <h2>Community Garden</h2>
                <p>Prepare garden beds, plant seasonal crops, and help deliver fresh produce.</p>
            </article>
            <article>
                <h2>Youth Mentoring</h2>
                <p>Share your time and skills with students through a local mentoring program.</p>
            </article>
            <article>
                <h2>Neighborhood Cleanup</h2>
                <p>Join neighbors for a morning of caring for shared parks and public spaces.</p>
            </article>
        </section>
    </main>
    <%- include('partials/footer') %>